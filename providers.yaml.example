# providers.yaml.example -- reference configuration for UMP.
#
# Copy this file to providers.yaml and adjust for your environment.
# Each entry under `providers` points to one OGC API Processes server.
# Only processes listed here are exposed through UMP.
# Available authentication types: NoAuth (default), BasicAuth, ApiKey, BearerToken.
# Available result-storage values: remote (default), geoserver.

providers:

  # Mock server (local development, no infrastructure required)
  # Start locally:  PYTHONPATH=scripts .venv/bin/uvicorn scripts.mock_ogc_server:app --port 5001
  # Docker Compose: docker compose -f docker-compose-dev.yaml up mock-ogc-server
  - name: mock
    url: "http://localhost:5001"
    processes:
      - id: echo
        anonymous-access: true
      - id: hello-world
        anonymous-access: true
      - id: slow
        anonymous-access: true
      - id: failing-job
        anonymous-access: true

  # Real model server with HTTP Basic auth
  - name: example
    url: "http://modelserver:5000"
    authentication:
      type: "BasicAuth"
      user: "user"
      password: "password"
    processes:
      - id: hello-world
        result-storage: "remote"
        anonymous-access: true
      - id: squareroot
        result-storage: "remote"
        anonymous-access: false
      - id: hello-geo-world
        result-storage: "geoserver"
        anonymous-access: true

  # Real model server with API key header
  - name: another-server
    url: "http://anotherserver:8080"
    authentication:
      type: "ApiKey"
      key_name: "X-API-Key"
      key_value: "secret-key-here"
    processes:
      - id: some-process
        anonymous-access: false
        exclude: false
