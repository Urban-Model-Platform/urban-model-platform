{
    "version": "2.0.0",
    "tasks": [{
        "label": "start-ump-dev",
        "type": "shell",
        "command": "docker",
        "args": [
            "compose",
            "-f",
            "docker-compose-dev.yaml",
            "up",
            "-d",
            "ump-db",
            // "mock-ogc-server"
        ],
    },{
            "label": "stop-ump-dev",
            "type": "shell",
            "command": "docker",
            "args": [
                "compose",
                "-f",
                "docker-compose-dev.yaml",
                "rm",
                "-s",
                "ump-db",
                "mock-ogc-server",
                "--force"
            ],
    },{
        "label":"run-db-migrations",
        "type": "shell",
        "command": "${workspaceFolder}/.venv/bin/ump-migrate",
        "options": {
            "cwd": "${workspaceFolder}",
            "env": {
                "UMP_DATABASE_URL": "postgresql+asyncpg://ump:ump@ump-db:5432/ump",
            }
        },
        "dependsOn": [
            "start-ump-dev"
        ],
    },{
        "label": "prepare-dev-setup",
        "dependsOn": [
            "start-ump-dev",
            "run-db-migrations"
        ]

    }]
}