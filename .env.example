#---- App settings ----
# The API_SERVER_URL is only used to return the complete URL in the result of the job details as specified in OGC.
# Should be the base url to the api.
UMP_SERVER_TIMEOUT=30
UMP_LOG_LEVEL=DEBUG
UMP_PROVIDERS_FILE=providers.yaml
UMP_API_SERVER_URL=http://localhost:5000
UMP_API_SERVER_HOST=0.0.0.0
UMP_API_SERVER_PORT=8000
UMP_API_SERVER_URL_PREFIX=/api
UMP_REMOTE_JOB_STATUS_REQUEST_INTERVAL=5
#
UMP_DATABASE_NAME=ump
UMP_DATABASE_HOST=localhost
UMP_DATABASE_PORT=5433
UMP_DATABASE_USER=ump
UMP_DATABASE_PASSWORD=ump

## minutes:
UMP_JOB_DELETE_INTERVAL=240
UMP_AUTH_ENABLED=False
UMP_JWKS_URL=
UMP_JWT_ISSUER=
UMP_JWT_AUDIENCE=
UMP_JWT_ROLES_CLAIMS=roles
UMP_JWKS_CACHE_TTL_SECONDS=3600
UMP_PUBLIC_PROCESSES=True

#---- example modelserver settings
PYGEOAPI_SERVER_HOST=localhost
PYGEOAPI_SERVER_PORT_INTERNAL=5000
PYGEOAPI_SERVER_PORT_EXTERNAL=5005

#---- docker dev environment settings ----
DOCKER_NETWORK=ump_dev
WEBAPP_PORT_EXTERNAL=5003
API_DB_PORT_EXTERNAL=5433
GEOSERVER_PORT_EXTERNAL=8181
KEYCLOAK_PORT_EXTERNAL=8282

#---- Docker build settings ----
CONTAINER_REGISTRY=registry.io
CONTAINER_NAMESPACE=namespace
IMAGE_NAME=urban-model-platform
IMAGE_TAG=2.1.0
